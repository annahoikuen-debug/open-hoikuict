# Production environment settings for open-hoikuict
# Copy this file to .env (gitignored) and replace all placeholder values before deploying.
# Never commit .env to version control.

# ===== Environment =====
HOIKUICT_ENV=production

# ===== Secret keys (32+ chars/bytes, randomly generated) =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HOIKUICT_SECRET_KEY=replace-with-32-plus-char-random-secret
HOIKUICT_LOGIN_THROTTLE_HMAC_KEY=replace-with-32-plus-byte-random-hmac-key

# ===== Authentication =====
HOIKUICT_STAFF_AUTH_MODE=local_password
HOIKUICT_PARENT_AUTH_MODE=local_password
# Mock auth must NOT be enabled in production
# HOIKUICT_ENABLE_MOCK_AUTH=1

# ===== Password blocklist =====
# File must exist and be readable
HOIKUICT_PROFILE=embedded
HOIKUICT_PASSWORD_BLOCKLIST_PATH=assets/password-blocklist.txt

# ===== Cookies & CSRF =====
HOIKUICT_COOKIE_SECURE=1
HOIKUICT_CSRF_ENFORCE=1

# ===== Kiosk access (production must NOT be "open") =====
HOIKUICT_KIOSK_ACCESS_MODE=disabled
# If using token mode, also set:
# HOIKUICT_KIOSK_TOKEN=replace-with-kiosk-token

# ===== Push notification transport (production must NOT be "capture") =====
HOIKUICT_PUSH_TRANSPORT=disabled
# For webpush in production, also set VAPID keys and PUBLIC_ORIGIN:
# HOIKUICT_PUSH_VAPID_PUBLIC_KEY=...
# HOIKUICT_PUSH_VAPID_PRIVATE_KEY=...
# HOIKUICT_PUSH_VAPID_SUBJECT=mailto:admin@example.jp
# HOIKUICT_PUBLIC_ORIGIN=https://hoiku.example.jp

# ===== Reverse proxy (required; "*" prohibited) =====
# Set to your reverse proxy's IP or CIDR, e.g. 127.0.0.1 or 10.0.0.0/8
FORWARDED_ALLOW_IPS=127.0.0.1

# ===== Parent mail (SMTP required in production) =====
HOIKUICT_PARENT_MAIL_TRANSPORT=smtp
HOIKUICT_PARENT_REGISTRATION_BASE_URL=https://hoiku.example.jp
HOIKUICT_STAFF_RECOVERY_BASE_URL=https://staff.hoiku.example.jp
HOIKUICT_SMTP_HOST=smtp.example.jp
HOIKUICT_SMTP_PORT=587
HOIKUICT_SMTP_STARTTLS=1
HOIKUICT_SMTP_USERNAME=replace-with-smtp-username
HOIKUICT_SMTP_PASSWORD=replace-with-smtp-password
HOIKUICT_PARENT_MAIL_FROM=noreply@hoiku.example.jp

# ===== Worker count (single worker required for in-memory rate limiter consistency) =====
WEB_CONCURRENCY=1
# If running multiple workers, set HOIKUICT_ALLOW_MULTIWORKER_RATE_LIMIT=1

# ===== Database =====
HOIKUICT_DATABASE_URL=sqlite:///./hoikuict.db

# ===== Optional =====
HOIKUICT_LOG_LEVEL=INFO
HOIKUICT_ALLOWED_ORIGINS=https://hoiku.example.jp
HOIKUICT_PARENT_LOGIN_MFA=1
