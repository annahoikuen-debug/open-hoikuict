# ---------------------------------------------------------------------------
# 本番デプロイ用推奨環境変数（単一園オールインワン構成公式サポート）
# ---------------------------------------------------------------------------
# このファイルを .env へコピーして利用する場合、以下のプレースホルダー値を必ず強力なランダム値に差し替えてください。
# 詳細は PUBLISH_READINESS_CHECKLIST.md を参照してください。

# 動作プロファイル（embedded: 単一園オールインワン公式サポート / cloud: 分散マルチテナント※サポート対象外プレビュー）
HOIKUICT_PROFILE=embedded
# HOIKUICT_PROFILE=cloud

# 環境区分
HOIKUICT_ENV=production

# セキュリティ・セッション・CSRF
HOIKUICT_SECRET_KEY=replace-with-random-secret-key-at-least-32-bytes
HOIKUICT_COOKIE_SECURE=1
HOIKUICT_CSRF_ENFORCE=1
# 本番では kiosk access mode は open 以外（disabled または token）にすること
HOIKUICT_KIOSK_ACCESS_MODE=disabled
# HOIKUICT_KIOSK_ACCESS_MODE=token
# HOIKUICT_KIOSK_TOKEN=replace-with-kiosk-device-token

# 認証モード（本番では local_password 固定・モック認証無効）
HOIKUICT_ENABLE_MOCK_AUTH=0
HOIKUICT_PARENT_AUTH_MODE=local_password
HOIKUICT_STAFF_AUTH_MODE=local_password

# レート制限・監査HMAC鍵（32バイト以上推奨）
HOIKUICT_LOGIN_THROTTLE_HMAC_KEY=replace-with-random-hmac-key-at-least-32-bytes

# パスワードブロックリスト（本番必須：リポジトリ同梱の assets/password-blocklist.txt または拡張辞書を指定）
HOIKUICT_PASSWORD_BLOCKLIST_PATH=assets/password-blocklist.txt

# セッション設定
HOIKUICT_STAFF_SESSION_IDLE_MINUTES=30
HOIKUICT_STAFF_SESSION_ABSOLUTE_HOURS=12

# メール設定（本番必須）
# SMTP設定が揃っていないと保護者向けメール（OTP、打刻通知等）が送信できません
HOIKUICT_PARENT_MAIL_TRANSPORT=smtp
HOIKUICT_PARENT_REGISTRATION_BASE_URL=https://parents.example.jp
HOIKUICT_PARENT_MAIL_FROM=no-reply@example.jp
HOIKUICT_SMTP_HOST=smtp.example.jp
HOIKUICT_SMTP_PORT=587
HOIKUICT_SMTP_FROM=no-reply@example.jp
HOIKUICT_SMTP_STARTTLS=1

# リバースプロキシ設定（本番必須：信頼できるプロキシIP/CIDRのみ指定し、* は使用しない）
FORWARDED_ALLOW_IPS=127.0.0.1

# プッシュ通知トランスポート（本番では disabled または webpush）
HOIKUICT_PUSH_TRANSPORT=disabled
# HOIKUICT_PUSH_TRANSPORT=webpush

# 公開オリジン（本番はHTTPS必須）
HOIKUICT_PUBLIC_ORIGIN=https://hoiku.example.jp

# データベース接続（単一園公式構成では SQLite を推奨）
HOIKUICT_DATABASE_URL=sqlite:///./hoikuict.db
# 実験用 PostgreSQL 構成（公式サポート対象外）
# HOIKUICT_DATABASE_URL=postgresql://hoikuict:hoikuict_secret@localhost:5432/hoikuict
# HOIKUICT_DB_POOL_SIZE=20
# HOIKUICT_DB_MAX_OVERFLOW=10
HOIKUICT_AUTO_MIGRATE=1

# 暗号化キー（本番推奨：32バイト以上）
HOIKUICT_ENCRYPTION_KEY=replace-with-random-encryption-key-at-least-32-bytes

# シフトソルバー設定
HOIKUICT_SHIFT_SOLVER=auto
# サーバーレス・ソルバーAPI（※サポート対象外拡張。未設定時はローカル内蔵ソルバーを使用）
# HOIKUICT_SERVERLESS_SOLVER_URL=https://nusoft-solver-xxx.a.run.app
# HOIKUICT_SERVERLESS_SOLVER_TOKEN=replace-with-solver-bearer-token
# HOIKUICT_SERVERLESS_SOLVER_TIMEOUT=45

# ---------------------------------------------------------------------------
# ローカル開発用設定例（本番環境では絶対に有効化しないこと）
# ---------------------------------------------------------------------------
# HOIKUICT_ENV=development
# HOIKUICT_ENABLE_MOCK_AUTH=1
# HOIKUICT_COOKIE_SECURE=0
# HOIKUICT_KIOSK_ACCESS_MODE=open
# HOIKUICT_CSRF_ENFORCE=0
# HOIKUICT_PARENT_MAIL_TRANSPORT=capture
# HOIKUICT_PUSH_TRANSPORT=capture
# FORWARDED_ALLOW_IPS=*
