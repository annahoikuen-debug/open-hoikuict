# Local development defaults. Copy this file to .env before starting Uvicorn.
# WARNING: このファイルには開発専用の非安全なデフォルト値が含まれます。
# 本番環境に .env.example の値をそのままコピーしないでください。
# 本番用設定は .env.production.example を参照し、すべて production-safe な値を設定してください。

HOIKUICT_ENV=development
HOIKUICT_ENABLE_MOCK_AUTH=1
# local password認証を試す場合はmockを0にし、次を設定する。
# HOIKUICT_STAFF_AUTH_MODE=local_password
# HOIKUICT_PARENT_AUTH_MODE=local_password
# HOIKUICT_LOGIN_THROTTLE_HMAC_KEY=32バイト以上のランダム値
# HOIKUICT_PASSWORD_BLOCKLIST_PATH=data/password-blocklist.txt
# HOIKUICT_STAFF_SESSION_IDLE_MINUTES=30
# HOIKUICT_STAFF_SESSION_ABSOLUTE_HOURS=12
# HOIKUICT_PARENT_MAIL_TRANSPORT=capture
# HOIKUICT_PARENT_REGISTRATION_BASE_URL=http://localhost:8000
# 管理者のメール再設定は上のメール設定・URLを共用。職員用URLが異なる場合だけ指定。
# HOIKUICT_STAFF_RECOVERY_BASE_URL=https://staff.example.jp
# リバースプロキシ配下だけ設定する。* は使わず、プロキシの送信元IP/CIDRに限定する。
# FORWARDED_ALLOW_IPS=127.0.0.1
# 開発専用：本番では kiosk access mode は open 以外（disabled または token）にすること
HOIKUICT_KIOSK_ACCESS_MODE=open
# 開発専用：本番では CSRF_ENFORCE=1 にすること
HOIKUICT_CSRF_ENFORCE=0
# 開発専用：本番では push transport は capture 以外（disabled または webpush）にすること
HOIKUICT_PUSH_TRANSPORT=capture
# webpushを選ぶ場合だけ、development専用の鍵と公開originを設定する。
# HOIKUICT_PUSH_VAPID_PUBLIC_KEY=
# HOIKUICT_PUSH_VAPID_PRIVATE_KEY=
# HOIKUICT_PUSH_VAPID_SUBJECT=mailto:developer@example.com
# HOIKUICT_PUBLIC_ORIGIN=https://localhost:8000

# Development only: anonymized review corpus (opened read-only).
HOIKU_DAILY_PLAN_EXAMPLES_DB_PATH=../hoiku-plan-corpus/work/anonymized-review.sqlite

# Daily reflection reminder shown to the plan owner after this local time.
HOIKU_DAILY_REFLECTION_REMINDER_TIME=16:30

# ---------------------------------------------------------------------------
# データベース接続（PostgreSQL 16+ 本番推奨 / SQLite はローカル開発・テスト用）
# ---------------------------------------------------------------------------
# HOIKUICT_DATABASE_URL=postgresql://hoikuict:hoikuict_secret@localhost:5432/hoikuict
# HOIKUICT_DB_POOL_SIZE=20
# HOIKUICT_DB_MAX_OVERFLOW=10
# HOIKUICT_AUTO_MIGRATE=1

# ---------------------------------------------------------------------------
# 機微情報（銀行口座・児童医療情報）の AES-256-GCM 暗号化キー
# ---------------------------------------------------------------------------
# 本番環境では必ず 32 バイト以上の強固な秘密鍵（または SECRET_KEY）を設定してください。
# HOIKUICT_ENCRYPTION_KEY=your-random-32-byte-or-more-secret-encryption-key

